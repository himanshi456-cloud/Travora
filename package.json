{
  "name": "travora-travel-operations-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "db:generate": "npm run prisma:generate --workspace backend",
    "db:migrate": "npm run prisma:migrate --workspace backend",
    "db:seed": "npm run seed --workspace backend",
    "db:studio": "npm run prisma:studio --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "db:deploy": "npm run prisma:deploy --workspace backend",
    "admin:create": "npm run admin:create --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
